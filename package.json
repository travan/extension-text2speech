{
  "name": "extension_text2speech",
  "version": "1.0.0",
  "description": "Chrome extension migration to React + TypeScript + Zustand.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run tests/unit",
    "test:local-ai": "vitest run tests/integration/local-ai.test.ts",
    "test:extension": "npm run build && playwright test --config playwright.extension.config.ts",
    "test:speech:native": "npm run build && NATIVE_SPEECH_HEADED=1 playwright test --config playwright.extension.config.ts tests/extension/native-speech.spec.ts",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test tests/e2e/popup-smoke.spec.ts",
    "test:e2e:flow": "playwright test tests/e2e/popup-flow.spec.ts tests/e2e/results-flow.spec.ts",
    "test:benchmark": "vitest run tests/integration/relevance-benchmark.test.ts",
    "verify": "node scripts/verify.mjs",
    "test:transport": "vitest run tests/transport"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.4.0",
    "@playwright/test": "^1.59.1",
    "@types/chrome": "^0.1.40",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "playwright": "^1.59.1",
    "type-fest": "^5.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vitest": "^3.2.4"
  }
}
